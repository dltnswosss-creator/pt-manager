generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id              Int      @id @default(autoincrement())
  name            String
  gender          String
  birthDate       String?
  phone           String?
  email           String?
  job             String?
  startDate       String?
  goal            String?

  // 운동 경험
  exerciseLevel   String?
  exerciseHistory String?

  // 병력/통증
  medicalHistory  String?
  painAreas       String?
  medications     String?

  // 생활 습관
  mealCount       Int?
  mealPattern     String?
  sleepHours      Float?

  // 메모
  memo            String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        Session[]
  menstrualCycle  MenstrualCycle?
  schedules       Schedule[]
  monthlyGoals    MonthlyGoal[]
}

model Session {
  id           Int        @id @default(autoincrement())
  clientId     Int
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date         String
  sessionType  String     @default("individual")
  duration     Int?
  memo         String?
  notionPageId String?
  notionUrl    String?
  exercises    Exercise[]
  createdAt    DateTime   @default(now())
}

model GroupSession {
  id           Int             @id @default(autoincrement())
  date         String
  title        String?
  memo         String?
  participants String[]        @default([])
  notionPageId String?
  notionUrl    String?
  exercises    GroupExercise[]
  createdAt    DateTime        @default(now())
}

model Exercise {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  sets      Int?
  reps      String?
  weight    Float?
  unit      String   @default("kg")
  memo      String?
  videoUrls String[] @default([])
  order     Int      @default(0)
}

model GroupExercise {
  id             Int          @id @default(autoincrement())
  groupSessionId Int
  groupSession   GroupSession @relation(fields: [groupSessionId], references: [id], onDelete: Cascade)
  name           String
  sets           Int?
  reps           String?
  weight         Float?
  unit           String       @default("kg")
  memo           String?
  videoUrls      String[]     @default([])
  order          Int          @default(0)
}

model MenstrualCycle {
  id            Int      @id @default(autoincrement())
  clientId      Int      @unique
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lastStartDate String
  cycleLength   Int      @default(28)
  periodLength  Int      @default(5)
  memo          String?
  updatedAt     DateTime @updatedAt
}

model MonthlyGoal {
  id              Int      @id @default(autoincrement())
  clientId        Int
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  yearMonth       String   // "YYYY-MM"

  // ACSM 기반 목표
  targetFrequency Int?     // 주당 세션 횟수 목표
  targetSets      Int?     // 세션당 세트 수 목표
  targetVolume    Int?     // 주당 총 세트 수 목표 (근비대 기준)
  intensityGuide  String?  // 강도 관련 가이드 문구

  feedback        String?  // 지난달 대비 자동/수동 피드백
  goalNote        String?  // 트레이너가 작성하는 목표 메모
  achieved        Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, yearMonth])
}

model Location {
  id        Int        @id @default(autoincrement())
  name      String
  address   String?
  color     String     @default("#6366f1")
  memo      String?
  schedules Schedule[]
  createdAt DateTime   @default(now())
}

model Schedule {
  id           Int       @id @default(autoincrement())
  date         String
  startTime    String
  endTime      String?
  type         String    @default("individual")
  status       String    @default("scheduled")
  clientId     Int?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  participants String[]  @default([])
  locationId   Int?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  memo         String?
  createdAt    DateTime  @default(now())
}
